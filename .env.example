# Copy to .env.local for development. Replace placeholders; never commit real secrets.
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER/servizato
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_A_CRYPTOGRAPHICALLY_RANDOM_SECRET
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use the same origin as Next.js so encrypted session cookies authenticate sockets.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000

# Optional Google login; configure both to enable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMS OTP delivery. Do not use production credentials in development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Existing Cloudinary image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Use Razorpay test-mode keys for development. Checkout uses the public key from the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server-only AES-256-GCM key: base64 encoding of exactly 32 random bytes. Never use a public variable.
# Leave blank to disable saving/revealing payout details safely. Back up the key before storing details.
PAYOUT_ENCRYPTION_KEY=wUd8j2gKXZ4QOWPyxKfTzgFtvSQnb1mSIuddyxYjPUQ=

# Optional protected finance maintenance job. 64 random hexadecimal characters; server runtime only.
# Needed only for the documented VPS weekly job and invoice-preparation CLI.
FINANCE_COLLECTION_JOB_TOKEN=eedf9db4199dbaf0dd1934cfb1dab131bb5c6ee95a1fca7a2dcc41d4a4849ea6

# Optional Google Maps Embed API browser key. Restrict to Maps Embed API and website referrers.
# Navigation URLs do not need a key. Address autofill uses the separate optional server key below.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Server-validated automatic arrival; tune only after real-device testing.
ARRIVAL_RADIUS_METERS=100
ARRIVAL_MAX_ACCURACY_METERS=40
ARRIVAL_REQUIRED_READINGS=2
ARRIVAL_MIN_READING_INTERVAL_MS=8000

# Optional address suggestions. Server runtime only; restrict to Geocoding API and server egress IPs.
# Leave blank for manual addresses. Set Cloud project quotas/billing alerts before enabling.
GOOGLE_MAPS_GEOCODING_API_KEY=
