# Copy to .env.local for development. Replace placeholders; never commit real secrets.
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER/servizato
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_A_CRYPTOGRAPHICALLY_RANDOM_SECRET
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use the same origin as Next.js so encrypted session cookies authenticate sockets.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000

# Optional Google login; configure both to enable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMS OTP delivery. Do not use production credentials in development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Existing Cloudinary image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Use Razorpay test-mode keys for development. Checkout uses the public key from the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Web Push. Server-only; the authenticated config endpoint exposes only the public key.
# Generate and store the pair in your deployment secret manager; never commit a real private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real monitored mailto: contact or HTTPS contact URL for the deployed application.
VAPID_SUBJECT=

# Server-only AES-256-GCM key: base64 encoding of exactly 32 random bytes. Never use a public variable.
# Leave blank to disable saving/revealing payout details safely. Back up the key before storing details.
PAYOUT_ENCRYPTION_KEY=

# Optional protected finance maintenance job. 64 random hexadecimal characters; server runtime only.
# Needed only for the documented VPS weekly job and invoice-preparation CLI.
FINANCE_COLLECTION_JOB_TOKEN=

# Optional Google Maps Embed API browser key. Restrict to Maps Embed API and website referrers.
# Navigation URLs do not need a key. Address autofill uses the separate optional server key below.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Server-validated automatic arrival; tune only after real-device testing.
ARRIVAL_RADIUS_METERS=100
ARRIVAL_MAX_ACCURACY_METERS=40
ARRIVAL_REQUIRED_READINGS=2
ARRIVAL_MIN_READING_INTERVAL_MS=8000

# Optional address suggestions. Server runtime only; restrict to Geocoding API and server egress IPs.
# Leave blank for manual addresses. Set Cloud project quotas/billing alerts before enabling.
GOOGLE_MAPS_GEOCODING_API_KEY=

# Optional overrides for approved general contact defaults: servizato.in@gmail.com / +919189299370.
# Only override with approved public details. These are not privacy/grievance disclosures.
# These NEXT_PUBLIC values are included in browser bundles; rebuild after changing them.
NEXT_PUBLIC_BUSINESS_CONTACT_EMAIL=
# International E.164 format, including the leading +.
NEXT_PUBLIC_BUSINESS_CONTACT_PHONE=

# Official social profile URLs have not yet been supplied. Leave empty until approved.
# Use complete HTTPS profile URLs on the matching platform; empty/invalid links stay hidden.
# Twitter / X accepts an official x.com or twitter.com profile URL.
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_TWITTER_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=

# Optional legal-page disclosures: publicly displayed, verified/approved details only.
# Leave empty while pending. Setting these values does not approve the legal documents.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_PRIVACY_EMAIL=
LEGAL_GRIEVANCE_NAME=
LEGAL_GRIEVANCE_DESIGNATION=
LEGAL_GRIEVANCE_EMAIL=
